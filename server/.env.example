# Banco de dados PostgreSQL (o docker-compose da raiz sobe um com esses dados)
DATABASE_URL="postgresql://squad:squad@localhost:5432/squad?schema=public"

# Porta da API
PORT=4000

# Endereço do front (CORS)
CLIENT_URL="http://localhost:5173"

# Segredo usado para assinar os tokens de login (troque por qualquer texto grande)
JWT_SECRET="troque-este-segredo-por-um-texto-grande"

# --- Opcionais ---
# RAWG.io (catálogo). Sem chave, o sistema usa só o catálogo local (seed).
RAWG_API_KEY=""

# Anthropic Claude (recomendação por IA). Sem chave, usa um recomendador simples por gênero.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Modelo usado na moderação de comentários (rápido e barato)
MODERATION_MODEL="claude-haiku-5-5"

# Google OAuth (login social). Mesmo Client ID usado no front (VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=""
