// Squad — modelo de dados (PostgreSQL via Prisma)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Usuários e social (RF01–RF05) ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  username     String   @unique
  bio          String?
  avatarUrl    String?
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  followers       Follow[]         @relation("following")
  following       Follow[]         @relation("follower")
  favorites       Favorite[]
  reviews         Review[]
  comments        Comment[]
  topics          Topic[]
  replies         Reply[]
  guides          Guide[]
  indications     Indication[]
  indicationLikes IndicationLike[]
  recommendations Recommendation[]
  ownedServers    Server[]
  memberships     ServerMember[]
  messages        Message[]
  suggestions     GameSuggestion[]
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

// ---------- Catálogo (RF06, RF07, RF13) ----------

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  slug  String @unique
  games Game[]
}

model Platform {
  id    Int    @id @default(autoincrement())
  name  String @unique
  slug  String @unique
  games Game[]
}

model Game {
  id          Int        @id @default(autoincrement())
  rawgId      Int?       @unique
  slug        String     @unique
  name        String
  description String?
  coverUrl    String?
  released    DateTime?
  metacritic  Int?
  rating      Float?
  trailerYoutubeId String?
  syncedAt    DateTime?
  createdAt   DateTime   @default(now())
  genres      Genre[]
  platforms   Platform[]

  favorites       Favorite[]
  reviews         Review[]
  topics          Topic[]
  guides          Guide[]
  indications     Indication[]
  recommendations Recommendation[]
  servers         Server[]
}

model Favorite {
  userId    String
  gameId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
}

// ---------- Reviews e comentários (RF08, RF11) ----------

model Review {
  id        String    @id @default(cuid())
  rating    Int
  text      String
  spoiler     Boolean   @default(false)
  spoilerAuto Boolean   @default(false)
  userId    String
  gameId    Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@unique([userId, gameId])
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  spoiler     Boolean  @default(false)
  spoilerAuto Boolean  @default(false)
  userId    String
  reviewId  String?
  guideId   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review?  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  guide     Guide?   @relation(fields: [guideId], references: [id], onDelete: Cascade)
}

// ---------- Fórum (RF09) ----------

model Topic {
  id             String   @id @default(cuid())
  title          String
  body           String
  spoiler     Boolean  @default(false)
  spoilerAuto Boolean  @default(false)
  userId         String
  gameId         Int?
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game           Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  replies        Reply[]
}

model Reply {
  id        String   @id @default(cuid())
  body      String
  spoiler     Boolean  @default(false)
  spoilerAuto Boolean  @default(false)
  userId    String
  topicId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

// ---------- Guias (RF10) ----------

enum GuideStatus {
  DRAFT
  PUBLISHED
}

model Guide {
  id          String      @id @default(cuid())
  title       String
  content     String
  status      GuideStatus @default(DRAFT)
  userId      String
  gameId      Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  publishedAt DateTime?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game?       @relation(fields: [gameId], references: [id], onDelete: SetNull)
  comments    Comment[]
}

// ---------- Indicações da comunidade (extra) ----------

model Indication {
  id        String           @id @default(cuid())
  reason    String
  spoiler     Boolean  @default(false)
  spoilerAuto Boolean  @default(false)
  tags      String[]         @default([])
  userId    String
  gameId    Int
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  likes     IndicationLike[]
}

model IndicationLike {
  userId       String
  indicationId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  indication   Indication @relation(fields: [indicationId], references: [id], onDelete: Cascade)

  @@id([userId, indicationId])
}

// ---------- Recomendação por IA (RF12) — cache ----------

model Recommendation {
  id        String   @id @default(cuid())
  batchId   String
  reason    String
  userId    String
  gameId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, batchId])
}

// ---------- Comunidade estilo Discord (extra) ----------

enum ChannelType {
  TEXT
  VOICE
}

model Server {
  id          String         @id @default(cuid())
  name        String
  description String?
  color       String         @default("#7c5cff")
  ownerId     String
  gameId      Int?
  createdAt   DateTime       @default(now())
  owner       User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  game        Game?          @relation(fields: [gameId], references: [id], onDelete: SetNull)
  channels    Channel[]
  members     ServerMember[]
}

model ServerMember {
  userId   String
  serverId String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([userId, serverId])
}

model Channel {
  id       String      @id @default(cuid())
  name     String
  type     ChannelType @default(TEXT)
  position Int         @default(0)
  serverId String
  server   Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  content   String
  spoiler     Boolean  @default(false)
  spoilerAuto Boolean  @default(false)
  userId    String
  channelId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

// ---------- Sugestões de jogos para o catálogo (recebidas pela equipe) ----------

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

model GameSuggestion {
  id        String           @id @default(cuid())
  name      String
  platform  String?
  link      String?
  reason    String?
  status    SuggestionStatus @default(PENDING)
  teamNote  String?
  userId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}
